# Percona Valkey Bundle image: the Percona Valkey server plus every supported
# module (json, bloom, search, ldap, audit), installed from the percona-valkey-bundle
# meta-package. The entrypoint auto-loads all installed modules.
#
# Base: Red Hat Universal Base Image 9 (minimal), pinned by digest — same base
# as the server image (docker/Dockerfile). Refresh after a base bump with:
#   docker pull redhat/ubi9-minimal:<tag>
#   docker inspect --format '{{index .RepoDigests 0}}' redhat/ubi9-minimal:<tag>
#
# SBOM and provenance are produced by BuildKit at build time
# (docker buildx build --sbom=true --provenance=mode=max) and attached to the
# pushed image as attestations. No SBOM files are kept inside the image.
ARG BASE_IMAGE=redhat/ubi9-minimal
ARG BASE_TAG=latest
ARG BASE_DIGEST=sha256:850143255ee0d1915f09aaa09f6ed31f24086ba605c323badfbefa95b8c52b0e

FROM ${BASE_IMAGE}:${BASE_TAG}@${BASE_DIGEST}

ARG BASE_IMAGE
ARG BASE_TAG
ARG BASE_DIGEST
ARG VALKEY_VERSION=9.1.3
ARG REPO_CHANNEL=testing

LABEL org.opencontainers.image.authors="info@percona.com" \
      org.opencontainers.image.source="https://github.com/valkey-io/valkey-bundle" \
      org.opencontainers.image.vendor="Percona" \
      org.opencontainers.image.title="Percona Valkey Bundle" \
      org.opencontainers.image.description="Percona Valkey server bundled with all supported modules (json, bloom, search, ldap, audit)" \
      org.opencontainers.image.version="${VALKEY_VERSION}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}:${BASE_TAG}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}"

ENV VALKEY_VERSION=${VALKEY_VERSION}

RUN microdnf -y update && \
    microdnf -y install glibc-langpack-en && \
    microdnf clean all

# Import Percona + CentOS signing keys, add the Percona repo, then install the
# percona-valkey-bundle meta-package — which pulls in the server and all five
# module packages.
RUN set -ex; \
    export GNUPGHOME="$(mktemp -d)"; \
    gpg --batch --keyserver keyserver.ubuntu.com --recv-keys 4D1BB29D63D98E422B2113B19334A25F8507EFA5 99DB70FAE1D7CE227FB6488205B555B38483C65D; \
    gpg --batch --export --armor 4D1BB29D63D98E422B2113B19334A25F8507EFA5 > ${GNUPGHOME}/PERCONA-PACKAGING-KEY; \
    gpg --batch --export --armor 99DB70FAE1D7CE227FB6488205B555B38483C65D > ${GNUPGHOME}/RPM-GPG-KEY-centosofficial; \
    rpmkeys --import ${GNUPGHOME}/PERCONA-PACKAGING-KEY ${GNUPGHOME}/RPM-GPG-KEY-centosofficial; \
    microdnf install -y findutils; \
    curl -Lf -o /tmp/percona-release.rpm https://repo.percona.com/yum/percona-release-latest.noarch.rpm; \
    rpmkeys --checksig /tmp/percona-release.rpm; \
    rpm -i /tmp/percona-release.rpm; \
    rm -rf "$GNUPGHOME" /tmp/percona-release.rpm; \
    rpm --import /etc/pki/rpm-gpg/PERCONA-PACKAGING-KEY; \
    percona-release disable all; \
    percona-release enable valkey-91 ${REPO_CHANNEL}; \
    microdnf -y install \
        tar \
        gawk \
        procps-ng \
        shadow-utils \
        percona-valkey-bundle; \
    microdnf clean all; \
    rm -rf /var/cache/dnf /var/cache/yum; \
    # The Percona packages ship per-package SBOM files under /usr/share/<pkg>/sbom/.
    # BuildKit's SBOM scanner ingests every SBOM file it finds in the image, which
    # pushes the attestation past BuildKit's 40 MiB limit and fails the export.
    # The image-level SBOM attestation already covers these packages.
    rm -rf /usr/share/percona-valkey*/sbom; \
    # Valkey refuses to load a non-executable module; force 0755 defensively in
    # case a module package ships the .so without the exec bit.
    chmod 0755 /usr/lib64/valkey/modules/*.so 2>/dev/null || true

RUN mkdir /data && chown valkey:valkey /data
VOLUME /data
WORKDIR /data

COPY bundle-docker-entrypoint.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/bundle-docker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/bundle-docker-entrypoint.sh"]

USER valkey

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD valkey-cli ping || exit 1

EXPOSE 6379
CMD ["valkey-server"]
