# Base: Docker Hardened Image (DHI) Community — debian-base (dhi.io).
# Pinned by digest for reproducible builds and to satisfy Docker Scout's
# "outdated base images" policy. Tag is kept alongside the digest for
# readability; the digest is what actually pins the build.
# Refresh after a base bump with:
#   docker pull dhi.io/debian-base:<tag>
#   docker inspect --format '{{index .RepoDigests 0}}' dhi.io/debian-base:<tag>
ARG BASE_IMAGE=dhi.io/debian-base
ARG BASE_DEV_TAG=trixie-dev
ARG BASE_DEV_DIGEST=sha256:94571f3dc07fbc7166f6f1cbf1fe068a7647198ee2554e6b90d59a68cc8b053c
ARG BASE_RUNTIME_TAG=trixie
ARG BASE_RUNTIME_DIGEST=sha256:5c9d8c2c90a0a4672f44a42a485c99e1b95f4bfad5c8ef49934f34b7ffb6e23b

FROM ${BASE_IMAGE}:${BASE_DEV_TAG}@${BASE_DEV_DIGEST} AS package-install

ARG REPO_CHANNEL=testing

# Install Valkey from the Percona repo, then add Syft (build stage only — it is
# never copied into the runtime image) for SBOM generation in the next stage.
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
	printf 'Dpkg::Options { "--force-confdef"; "--force-confold"; };\n' > /etc/apt/apt.conf.d/90-confdef; \
	printf 'Acquire::Retries "5";\nAcquire::Retries::Delay "true";\nAcquire::http::Timeout "120";\nAcquire::https::Timeout "120";\nAcquire::http::Pipeline-Depth "0";\n' > /etc/apt/apt.conf.d/80-retries; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		wget \
		gnupg \
		gpgv \
		curl \
		lsb-release \
		bsdutils \
	; \
	groupadd -r adm 2>/dev/null || true; \
	groupadd -r valkey 2>/dev/null || groupadd -r -g 998 valkey; \
	useradd -r -g valkey -G adm -d /var/lib/valkey -s /usr/sbin/nologin valkey; \
	mkdir -p /var/lib/valkey; \
	chown valkey:valkey /var/lib/valkey; \
	apt-get update; \
	apt-get upgrade -y; \
	wget -q -O /tmp/percona-release.deb https://repo.percona.com/apt/percona-release_latest.generic_all.deb; \
	dpkg -i /tmp/percona-release.deb; \
	percona-release enable valkey-91 ${REPO_CHANNEL}; \
	apt-get install -y --no-install-recommends \
		percona-valkey-server \
		percona-valkey-tools \
		percona-valkey-sentinel \
		mawk \
	; \
	rm -rf /var/lib/apt/lists/* /tmp/*.deb; \
	mkdir -p /usr/local/bin; \
	curl -sSfL https://get.anchore.io/syft | sh -s -- -b /usr/local/bin; \
	valkey-cli --version; \
	valkey-server --version; \
	syft version

# Prepare runtime filesystem layout in the build stage, then generate a real
# SBOM (SPDX + CycloneDX) by scanning the assembled /runtime rootfs. Scanning
# /runtime (rather than /) keeps the inventory limited to what the distroless
# image actually ships — no build-only tooling such as wget/gnupg/syft.
RUN set -eux; \
	mkdir -p /runtime/data /runtime/run/valkey /runtime/etc /runtime/usr/local/bin /runtime/usr/local; \
	\
	cp /usr/bin/valkey-* /runtime/usr/local/bin/; \
	cp -a /etc/valkey /runtime/etc/valkey; \
	\
	# awk for in-container scripting (the distroless base ships no text tools).
	# Use mawk: it needs only libc/libm — both already collected for valkey — so
	# nothing extra to copy. (gawk pulls libsigsegv/libmpfr/…, which ldd fails to
	# collect under the QEMU arm64 cross-build, breaking awk on arm64.) \
	cp "$(command -v mawk)" /runtime/usr/local/bin/awk; \
	\
	for bin in /usr/bin/valkey-server /usr/bin/valkey-cli; do \
		ldd "$bin" | awk '/=>/ {print $3}' | while read -r lib; do \
			if [ -f "$lib" ]; then \
				libdir="$(dirname "$lib" | sed 's|^/lib|/usr/lib|')"; \
				mkdir -p "/runtime${libdir}"; \
				cp -L "$lib" "/runtime${libdir}/"; \
			fi; \
		done; \
	done; \
	\
	VALKEY_UID=$(id -u valkey); \
	VALKEY_GID=$(getent group valkey | cut -d: -f3); \
	chown ${VALKEY_UID}:${VALKEY_GID} /runtime/data /runtime/run/valkey /runtime/etc/valkey; \
	chmod 750 /runtime/data /runtime/run/valkey; \
	\
	grep '^valkey:' /etc/passwd > /runtime/etc/passwd.valkey; \
	grep '^root:' /etc/passwd >> /runtime/etc/passwd.valkey; \
	grep '^valkey:' /etc/group > /runtime/etc/group.valkey; \
	grep '^root:' /etc/group >> /runtime/etc/group.valkey; \
	\
	# Per-package SBOM set the percona-valkey package ships under \
	# /usr/share/percona-valkey/sbom/ — carry it into the distroless image so the \
	# full embedded set (spdx/cdx json+xml, Syft table, licenses) is preserved, not \
	# just the /runtime scan below. (The UBI9 image gets these from the package.) \
	mkdir -p /runtime/usr/share; \
	for d in /usr/share/percona-valkey*/; do \
		if [ -d "${d}sbom" ]; then \
			mkdir -p "/runtime${d}"; \
			cp -a "${d}sbom" "/runtime${d}"; \
		fi; \
	done; \
	\
	vkver="$(valkey-server --version | awk '{print $3}' | cut -d= -f2)"; \
	syft scan dir:/runtime \
		--source-name percona-valkey --source-version "$vkver" \
		-o spdx-json=/tmp/valkey.spdx.json \
		-o cyclonedx-json=/tmp/valkey.cdx.json; \
	cp /tmp/valkey.spdx.json /tmp/valkey.cdx.json /runtime/usr/local/

COPY docker-entrypoint.sh /runtime/usr/local/bin/docker-entrypoint.sh
RUN chmod 755 /runtime/usr/local/bin/docker-entrypoint.sh

FROM ${BASE_IMAGE}:${BASE_RUNTIME_TAG}@${BASE_RUNTIME_DIGEST}

ENV VALKEY_VERSION=9.1.3

LABEL org.opencontainers.image.source="https://github.com/valkey-io/valkey" \
      org.opencontainers.image.vendor="Percona" \
      org.opencontainers.image.title="Valkey (Hardened)" \
      org.opencontainers.image.description="Hardened Valkey image built on Docker Hardened Image (DHI)" \
      org.opencontainers.image.version="9.1.3" \
      org.opencontainers.image.base.name="dhi.io/debian-base:trixie" \
      org.opencontainers.image.base.digest="sha256:5c9d8c2c90a0a4672f44a42a485c99e1b95f4bfad5c8ef49934f34b7ffb6e23b"

# Copy passwd/group entries for valkey user
COPY --from=package-install /runtime/etc/passwd.valkey /etc/passwd
COPY --from=package-install /runtime/etc/group.valkey /etc/group

# Copy valkey binaries, config, and SBOM (SPDX + CycloneDX)
COPY --from=package-install /runtime/usr/local/bin/ /usr/local/bin/
COPY --from=package-install /runtime/usr/local/valkey.spdx.json /usr/local/
COPY --from=package-install /runtime/usr/local/valkey.cdx.json /usr/local/
COPY --from=package-install /runtime/etc/valkey/ /etc/valkey/
# Per-package SBOM set (spdx/cdx json+xml, Syft table, licenses), same path as the UBI9 image.
COPY --from=package-install /runtime/usr/share/ /usr/share/

# Copy all shared libraries valkey needs (collected via ldd)
# Preserves architecture-specific paths (x86_64-linux-gnu or aarch64-linux-gnu)
COPY --from=package-install /runtime/usr/lib/ /usr/lib/

# Copy data and run directories with correct ownership
COPY --chown=valkey:valkey --from=package-install /runtime/data/ /data/
COPY --chown=valkey:valkey --from=package-install /runtime/run/valkey/ /run/valkey/

WORKDIR /data

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
	CMD valkey-cli ping || exit 1

VOLUME ["/data"]

EXPOSE 6379

USER valkey

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["valkey-server"]
